{
  "realm": "support-poc",
  "enabled": true,
  "displayName": "Support Desk PoC",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Puede consultar su información y crear tickets" },
      { "name": "support_l1", "description": "Puede leer tickets de sus colas asignadas" }
    ]
  },
  "clientScopes": [
    {
      "name": "support-access",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "subject (sub)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "mcp-support audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp-support",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "user display name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "user email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "assigned support queues",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "assigned_queues",
            "claim.name": "assigned_queues",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "support:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "support:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ],
  "clients": [
    {
      "clientId": "agent-bff",
      "name": "Support Chat BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-only-agent-bff-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:8000/auth/callback"],
      "webOrigins": ["http://localhost:8000"],
      "fullScopeAllowed": true,
      "defaultClientScopes": ["support-access", "support:read", "support:write"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "mcp-support",
      "name": "Support MCP Resource Server",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alicia",
      "lastName": "Colaboradora",
      "email": "alice@example.test",
      "realmRoles": ["employee"],
      "credentials": [{ "type": "password", "value": "alice-demo-pass", "temporary": false }]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Beto",
      "lastName": "Colaborador",
      "email": "bob@example.test",
      "realmRoles": ["employee"],
      "credentials": [{ "type": "password", "value": "bob-demo-pass", "temporary": false }]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "soporte",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sofía",
      "lastName": "Soporte L1",
      "email": "soporte@example.test",
      "attributes": { "assigned_queues": ["network"] },
      "realmRoles": ["support_l1"],
      "credentials": [{ "type": "password", "value": "soporte-demo-pass", "temporary": false }]
    }
  ]
}
