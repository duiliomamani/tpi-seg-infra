# Copiar a .env para usar Docker Compose. Son credenciales sintéticas sólo para loopback.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=local-only-admin-pass
OIDC_CLIENT_SECRET=local-only-agent-bff-secret
APP_ACTION_SECRET=local-only-change-this-action-secret-please

# Ollama se levanta dentro de Docker Compose. El modelo se descarga una vez
# y queda persistido en el volumen ollama-data.
OLLAMA_IMAGE=ollama/ollama:0.40.16
LLM_MODEL=qwen3.5:2b
LLM_LOCAL=true
LLM_TIMEOUT_SECONDS=60
LLM_TOOL_CALLING_ENABLED=true

# Caso de grupos: secure aplica OPA; vulnerable omite la autorización de recurso para la demo local.
GROUPS_DEMO_MODE=secure

# Para una ejecución con TLS y dominio propios, cambiar a true y configurar URLs/hosts.
COOKIE_SECURE=false
