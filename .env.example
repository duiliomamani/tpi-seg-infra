# Copiar a .env para usar Docker Compose. Son credenciales sintéticas sólo para loopback.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=local-only-admin-pass
OIDC_CLIENT_SECRET=local-only-agent-bff-secret
APP_ACTION_SECRET=local-only-change-this-action-secret-please

# Ollama se levanta dentro de Docker Compose. El modelo se descarga una vez
# y queda persistido en el volumen ollama-data.
OLLAMA_IMAGE=ollama/ollama:0.40.16
LLM_MODEL=qwen3.5:2b
LLM_LOCAL=true
LLM_TIMEOUT_SECONDS=60
LLM_TOOL_CALLING_ENABLED=true

# Caso de grupos: secure aplica OPA; vulnerable omite la autorización de recurso para la demo local.
GROUPS_DEMO_MODE=vulnerable

# Caso de prompt injection: vulnerable entrega el memo no aprobado y usa un planificador débil para la instrucción directa.
# El reset vulnerable sólo opera sobre cuentas sintéticas del realm local support-poc.
PROMPT_INJECTION_DEMO_MODE=vulnerable

# Caso de envenenamiento: vulnerable deja llegar al agente una política falsa sintética y no aprobada.
DATA_POISONING_DEMO_MODE=vulnerable

# Caso de precios: vulnerable omite autorización del agente y MCP para probar
# cambios y consultas sobre datos sintéticos; secure exige soporte_admin, aprobación y OPA.
PRODUCT_DATA_DEMO_MODE=vulnerable

# Caso de ticket ajeno: vulnerable omite la autorización por propietario/cola
# sólo para los tickets sintéticos de la PoC; secure aplica OPA.
TICKET_DEMO_MODE=vulnerable

# Consola de la PoC local: cualquier perfil autenticado puede cambiar el modo global desde el frontend.
# Dejar false fuera de la PoC local con datos sintéticos.
DEMO_MODE_CONTROL_ENABLED=true

# Reset MFA real sólo dentro del realm sintético support-poc. Compose crea un
# cliente de servicio en master, limitado a manage-users/query-users/view-users
# del cliente support-poc-realm y al scope kc-admin-api requerido por Keycloak 26.8.
KEYCLOAK_MFA_RESET_ENABLED=true
KEYCLOAK_MFA_ADMIN_CLIENT_ID=mcp-mfa-operator
KEYCLOAK_MFA_ADMIN_CLIENT_SECRET=local-only-mcp-mfa-operator-secret

# Para una ejecución con TLS y dominio propios, cambiar a true y configurar URLs/hosts.
COOKIE_SECURE=false
